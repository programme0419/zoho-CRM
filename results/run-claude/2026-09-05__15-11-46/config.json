{
    "jobs_dir": "/workspace/results/run-claude",
    "n_attempts": 3,
    "n_concurrent_trials": 1,
    "environment": {
        "type": "docker",
        "extra_docker_compose": [
            "/workspace/scripts/docker-compose.bridge.yaml"
        ]
    },
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-opus-5",
            "kwargs": {
                "reasoning_effort": "max"
            },
            "env": {
                "CLAUDE_FORCE_OAUTH": "****",
                "CLAUDE_CODE_OAUTH_TOKEN": "${CLAUDE_CODE_OAUTH_TOKEN}",
                "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "****"
            }
        }
    ],
    "tasks": [
        {
            "path": "tasks/scan-margin"
        }
    ]
}